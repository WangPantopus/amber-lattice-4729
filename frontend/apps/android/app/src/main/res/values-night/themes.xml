<?xml version="1.0" encoding="utf-8"?>
<!-- Pantopus currently renders the light palette (`PantopusTheme(darkTheme = false)`).
     Align the night starting window with the light theme so cold launch in system dark
     mode never flashes black before Compose paints `appSurface` and status-bar icons
     stay dark and readable from the first frame. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Pantopus" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/pantopus_app_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- ShareInActivity: a sheet over the app that shared, so that app stays visible behind it. -->
    <style name="Theme.Pantopus.ShareIn" parent="Theme.Pantopus">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
    </style>
</resources>
